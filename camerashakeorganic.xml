<!DOCTYPE kpartgui>
<effect tag="frei0r.camerashakeorganic" id="frei0r.camerashakeorganic" type="video">
    <name>Camera Shake Organic</name>
    <description>Organic irregular camera shake with noise on movement, rotation, blur, zoom and occasional speed slowdown.</description>
    <author>Modified by acc4commissions and Grok 4.3</author>

    <parameter type="animated" name="amplitude_x" max="1000" min="0" default="8">
        <name>X Amplitude (px)</name>
    </parameter>
    <parameter type="animated" name="amplitude_y" max="1000" min="0" default="8">
        <name>Y Amplitude (px)</name>
    </parameter>
    <parameter type="animated" name="rotation" max="3600" min="0" default="2">
        <name>Max Rotation (x0.1°)</name>
    </parameter>
    <parameter type="animated" name="blur" max="100" min="0" default="0">
        <name>Blur (animated)</name>
    </parameter>
    <parameter type="animated" name="speed" max="1000" min="0" default="55">
        <name>Speed</name>
    </parameter>
    <parameter type="animated" name="speed_noise" max="100" min="0" default="0">
        <name>Speed Noise (%)</name>
    </parameter>
    <parameter type="animated" name="zoom" max="400" min="50" default="100">
        <name>Zoom (%)</name>
    </parameter>
    <parameter type="bool" name="edge_smoothing" default="0">
        <name>Edge Smoothing</name>
    </parameter>
    <parameter type="animated" name="seed" max="1000" min="-1000" default="0">
        <name>Seed / Phase</name>
    </parameter>
</effect>
