<!DOCTYPE kpartgui>
<effect tag="frei0r.camerashakeorganic" id="frei0r.camerashakeorganic" type="video">
    <name>Camera Shake Organic</name>
    <description>Organic irregular camera shake with noise on movement, rotation and blur.</description>
    <author>Modified by acc4commissions and Grok 4.3</author>
    
    <parameter type="animated" name="amplitude_x" max="1250" min="0" default="8">
        <name>X Amplitude (x0.2px)</name>
    </parameter>
    <parameter type="animated" name="amplitude_y" max="1250" min="0" default="8">
        <name>Y Amplitude (x0.2px)</name>
    </parameter>
    <parameter type="animated" name="rotation" max="900" min="0" default="2">
        <name>Max Rotation (x0.2°)</name>
    </parameter>
    <parameter type="animated" name="zoom" max="400" min="50" default="100">
        <name>Zoom (%)</name>
    </parameter>
    <parameter type="animated" name="speed" max="400" min="0" default="55">
        <name>Speed</name>
    </parameter>
    <parameter type="animated" name="blur" max="300" min="0" default="0">
        <name>Blur</name>
    </parameter>
    <parameter type="animated" name="seed" max="1000" min="-1000" default="0">
        <name>Seed / Phase</name>
    </parameter>
</effect>
